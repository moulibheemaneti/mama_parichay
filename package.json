{
   "name": "mama_parichay",
   "version": "0.0.1",
   "type": "module",
   "private": true,
   "homepage": "https://www.mamaparichay.com",
   "scripts": {
      "build": "bun --bun nuxt build",
      "dev": "bun --bun nuxt dev",
      "generate": "bun --bun nuxt generate",
      "preview": "bun --bun nuxt preview",
      "postinstall": "bun --bun nuxt prepare",
      "prepare": "commitguard install",
      "lint": "bunx --bun eslint .; stylelint '**/*.scss'",
      "lint:fix": "bunx --bun eslint . --fix; stylelint --fix '**/*.scss'",
      "clean": "rm -rf .nuxt .output dist",
      "clean:all": "bun clean && rm -rf bun.lock",
      "typecheck": "vue-tsc --build --noEmit",
      "test": "bunx --bun vitest run",
      "test:watch": "bunx --bun vitest"
   },
   "dependencies": {
      "@nuxt/eslint": "1.17.0",
      "@vercel/analytics": "^2.0.1",
      "@vercel/speed-insights": "^2.0.0",
      "eslint": "^10.8.0",
      "nuxt": "^4.5.2",
      "vue": "^3.5.41",
      "vue-router": "^5.2.0"
   },
   "devDependencies": {
      "@moulibheemaneti/commitguard": "^0.1.4",
      "@nuxt/test-utils": "^4.1.0",
      "@semantic-release/changelog": "^7.0.0",
      "@semantic-release/commit-analyzer": "^13.0.1",
      "@semantic-release/git": "^11.0.1",
      "@semantic-release/github": "^12.0.9",
      "@semantic-release/npm": "^13.1.5",
      "@semantic-release/release-notes-generator": "^14.1.1",
      "@stylistic/stylelint-plugin": "^5.2.1",
      "@vue/test-utils": "^2.4.11",
      "conventional-changelog-conventionalcommits": "^10.2.1",
      "happy-dom": "^20.11.1",
      "sass": "^1.102.0",
      "sass-embedded": "^1.100.0",
      "sass-true": "^10.1.0",
      "semantic-release": "^25.0.9",
      "stylelint": "^17.14.1",
      "stylelint-config-standard": "^40.0.0",
      "stylelint-config-standard-scss": "^17.0.0",
      "typescript": "^6.0.3",
      "vitest": "^4.1.10",
      "vue-tsc": "^3.3.9"
   }
}
